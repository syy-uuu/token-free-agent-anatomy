Result: import tkinter as tk
from tkinter import messagebox


class CalculatorApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Calculator")
        self.root.geometry("400x500")
        
        # Display widget for input/output
        self.display = tk.Entry(root, font=("Arial", 24), bd=10, 
                               insertwidth=2, width=25, borderwidth=0)
        self.display.grid(row=0, column=0, columnspan=5, padx=10, pady=10,
                         sticky="nsew")
        
        # Configure grid weights for proper sizing
        for i in range(7):
            self.root.grid_rowconfigure(i, weight=1)
        for i in range(4):
            self.root.grid_columnconfigure(i, weight=1)
        
        # Button configuration
        buttons = [
            ('C', 1, 0), ('CE', 1, 1), ('DEL', 1, 2), ('/', 1, 3),
            ('7', 2, 0), ('8', 2, 1), ('9', 2, 2), ('*', 2, 3),
            ('4', 3, 0), ('5', 3, 1), ('6', 3, 2), ('-', 3, 3),
            ('1', 4, 0), ('2', 4, 1), ('3', 4, 2), ('+', 4, 3),
            ('0', 5, 0), ('.', 5, 1), ('=', 5, 2), ('=', 5, 3),  # Double equals
        ]
        
        # Create buttons with different colors for operators vs numbers
        button_configs = {
            'C': {'text': 'C', 'bg': '#ff6b6b'},  # Red for clear
            'CE': {'text': 'CE', 'bg': '#ff6b6b'},
            'DEL': {'text': 'DEL', 'bg': '#ff6b6b'},
            '/': {'text': '/', 'bg': '#feca57'},
            '7': {'text': '7', 'fg': 'red', 'bg': 'white'},
            '8': {'text': '8', 'fg': 'red', 'bg': 'white'},
            '9': {'text': '9', 'fg': 'red', 'bg': 'white'},
            '*': {'text': '*', 'bg': '#feca57'},
            '4': {'text': '4', 'fg': 'blue', 'bg': 'white'},
            '5': {'text': '5', 'fg': 'blue', 'bg': 'white'},
            '6': {'text': '6', 'fg': 'blue', 'bg': 'white'},
            '-': {'text': '-', 'bg': '#feca57'},
            '1': {'text': '1', 'fg': 'blue', 'bg': 'white'},
            '2': {'text': '2', 'fg': 'blue', 'bg': 'white'},
            '3': {'text': '3', 'fg': 'blue', 'bg': 'white'},
            '+': {'text': '+', 'bg': '#feca57'},
            '0': {'text': '0', 'fg': 'blue', 'bg': 'white'},
            '.': {'text': '.', 'fg': 'blue', 'bg': 'white'},
            '=': {'text': '=', 'bg': '#48dbfb'},
        }
        
        for label, row, col in buttons:
            config = button_configs.get(label, {'text': label})
            button = tk.Button(root, text=config['text'], 
                              font=("Arial", 20), 
                              bg=config.get('bg', '#f8f9fa'),
                              fg=config.get('fg', 'black'),
                              activebackground='#e9ecef',
                              activeforeground='black',
                              padx=20, pady=20,
                              cursor="hand2",
                              command=lambda l=label: self.on_button_click(l))
            button.grid(row=row, column=col, ipadx=10, ipady=10)
    
    def on_button_click(self, label):
        """Handle button clicks"""
        if label == 'C':
            self.display.delete(0, tk.END)
        elif label == 'CE':
            self.display.delete(0, len(self.display.get()))
        elif label == 'DEL':
            current = self.display.get()
            self.display.delete(len(current)-1, tk.END)
        elif label in ['+', '-', '*', '/']:
            current = self.display.get()
            self.display.insert(tk.END, label)
        elif label == '=':
            try:
                current = self.display.get()
                # Replace visual operators with Python operators
                expr = current.replace('*', '**').replace('/', '/1e-9')
                result = eval(expr)
                if result % 1 == 0:
                    result = int(result)
                self.display.delete(0, tk.END)
                self.display.insert(tk.END, result)
            except ZeroDivisionError:
                self.display.insert(tk.END, "Error")
            except:
                self.display.insert(tk.END, "Error")
        else:
            current = self.display.get()
            if current.replace('.', '', 1).isdigit():
                self.display.delete(0, tk.END)
            self.display.insert(tk.END, label)


def main():
    root = tk.Tk()
    app = CalculatorApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()
------------------------------------------------------------

