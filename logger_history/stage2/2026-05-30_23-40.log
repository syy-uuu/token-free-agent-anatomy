Result: import tkinter as tk

root = tk.Tk()
frame = tk.Frame(root, padx=10, pady=10)
frame.grid(row=0, column=0)

# Output display
display = tk.Entry(frame, width=35, borderwidth=5)
output = 'Your result will appear here.'
display.insert(0, output)
display.grid(row=0, column=0, columnspan=4, sticky='ew')

# Number buttons
numbers_frame = tk.Frame(frame)
buttons = []
for i in range(1, 10):
    button = tk.Button(numbers_frame, text=str(i), width=5)
    buttons.append(button)
button_0 = tk.Button(numbers_frame, text='0', width=5)

# Arrange number buttons
row = 1
column = 3
for b in buttons:
    b.grid(row=row, column=column - 3)
    row += 1
column -= 1
button_0.grid(row=row, column=column - 2)
numbers_frame.grid(row=1, column=0)

# Operator buttons
operators_frame = tk.Frame(frame)
op_button_dict = {'+': '+', '-': '-', '*': '*', '/': '/'}
op_buttons = []
for op in op_button_dict:
    button = tk.Button(operators_frame, text=op, width=5)
    op_buttons.append(button)
op_labels = list(op_button_dict.values())

# Arrange operator buttons
row = 4
column = 3
for b, label in zip(op_buttons, op_labels):
    b.grid(row=row - column, column=column) 
    if row <= 6:
        row += 1
    else:
        column -= 1
operators_frame.grid(row=5, column=0)

# Clear and equals buttons
clear_button = tk.Button(frame, text='Clear', width=9)
equals_button = tk.Button(frame, text='=', width=9)
clear_button.grid(row=6, column=3)
equals_button.grid(row=6, column=2)

root.mainloop()
