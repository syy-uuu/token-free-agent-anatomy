def button_click(button):
    # Update display with the clicked button value
    if button.text() in '0123456789':
        display.setText(display.text() + button.text())
    elif button.text() == '+':
        update_display_on_addition()
    elif button.text() == '-':
        update_display_on_subtraction()

def update_display_on_addition():
    current_text = display.text()
    if '+' in current_text:
        parts = current_text.split('+')
        if len(parts) > 1:
            first_num, second_num = map(int, parts)
            result = first_num + second_num
            display.setText(str(result))

def update_display_on_subtraction():
    current_text = display.text()
    if '-' in current_text:
        parts = current_text.split('-')
        if len(parts) > 1:
            first_num, second_num = map(int, parts)
            result = first_num - second_num
            display.setText(str(result))

def main():
    root = tk.Tk()
    display = tk.Label(root, text='0')
    display.grid(row=0, column=0)
    for i in range(10):
        btn = tk.Button(root, text=str(i), command=lambda txt=str(i): button_click(tk.Button(root, text=txt)))
        btn.grid(row=(i//3)+4, column=i%3)
    plus_btn = tk.Button(root, text='+', command=lambda: button_click(tk.Button(root, text='+')))
    plus_btn.grid(row=7, column=1)

    minus_btn = tk.Button(root, text='-', command=lambda: button_click(tk.Button(root, text='-')))
    minus_btn.grid(row=8, column=1)
    root.mainloop()

