from .addition import TestAddition
from .subtraction import TestSubtraction
from .multiplication import TestMultiplication
from .division import TestDivision

def test_all():
    suite = unittest.TestSuite()
    suite.addTests([unittest.defaultTestLoader.loadTestsFromTestCase(TestAddition),
                    unittest.defaultTestLoader.loadTestsFromTestCase(TestSubtraction),
                    unittest.defaultTestLoader.loadTestsFromTestCase(TestMultiplication),
                    unittest.defaultTestLoader.loadTestsFromTestCase(TestDivision)])
    
    runner = unittest.TextTestRunner(verbosity=2)
    result = runner.run(suite)

if __name__ == "__main__":
    test_all()
```

