Arguments: {'content': "from tkinter import Tk, Label, Entry, Button, messagebox\nimport math\n\nclass CalculatorApp:\n    def __init__(self):\n        self.root = Tk()\n        self.root.title('Simple Calculator')\n\n        # Inputs\n        self.entry = Entry(self.root)\n        self.entry.grid(row=0, column=0, columnspan=4)\n\n        # Buttons\n        for i in range(10):\n            Button(self.root, text=str(i), command=lambda x=i: self.append_to_entry(x)).grid(row=(3-i)//3+1, column=(i-1)%3 + 1)\n\n        for operation in ['+', '-', '*', '/']:\n            Button(self.root, text=operation, command=lambda o=operation: self.apply_operation(o)).grid(row=i//4 + 2, column=i%4 + 1)\n\n    def append_to_entry(self, digit):\n        current_text = self.entry.get()\n        new_text = str(current_text) + str(digit)\n        self.entry.delete(0, tk.END)\n        self.entry.insert(tk.END, new_text)\n\n    def apply_operation(self, operation):\n        pass\n\ncalculator_app = CalculatorApp()\ncalculator_app.root.mainloop()", 'path': 'main.py'}
