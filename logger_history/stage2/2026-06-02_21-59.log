Arguments: {'path': 'main.py', 'content': "from tkinter import Tk, Label, Entry, Button, messagebox\nimport math\n\nclass CalculatorApp:\n    def __init__(self):\n        self.root = Tk()\n        self.root.title('Simple Calculator')\n\n        # Inputs\n        self.entry = Entry(self.root)\n        self.entry.grid(row=0, column=0, columnspan=4)\n\n        # Buttons\n        buttons = [('7', 1, 2), ('8', 1, 3), ('9', 1, 4), \n                   ('4', 2, 2), ('5', 2, 3), ('6', 2, 4),\n                   ('1', 3, 2), ('2', 3, 3), ('3', 3, 4), \n                   ('0', 4, 2)]\n        operations = [('+', 1, 5), ('-', 2, 5), ('*', 3, 5), ('/', 4, 5)]\n\n        for button_info in buttons + operations:\n            button_text, row, col = button_info\n            if button_text.isdigit():  # For numbers\n                command = lambda x=button_text: self.append_to_entry(x)\n            else:  # For operations\n                command = lambda o=button_text: self.apply_operation(o)\n            Button(self.root, text=button_text, command=command).grid(row=row, column=col)\n\n    def append_to_entry(self, digit):\n        current_text = self.entry.get()\n        new_text = str(current_text) + str(digit)\n        self.entry.delete(0, tk.END)\n        self.entry.insert(tk.END, new_text)\n\n    def apply_operation(self, operation):\n        pass\n\ncalculator_app = CalculatorApp()\ncalculator_app.root.mainloop()"}
