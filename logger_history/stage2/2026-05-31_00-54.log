import tkinter as tk
from tkinter import END, DISABLED, NORMAL, Button

class Calculator(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title('Calculator')
        self.geometry('400x500')
        self.resizable(False, False)
        
        # Initialize string variables for inputs and outputs.
        self.equation = tk.StringVar()
        self.label_display = tk.Label(self, textvariable=self.equation)
        self.label_display.grid(row=0, column=0, columnspan=4, padx=10, pady=5)  # Adjust grid positioning as necessary
        
        # Initialize current expression in the class scope
        self.current_expression = ''
        
    def create_ui(self):
        # Adding buttons for digits 0-9
        for i in range(3):
            for j in range(3):
                button = Button(self, text=str((i*3)+j), width=5, height=2,
                               command=lambda x=(str(i*3 + j)): self.press(x))
                button.grid(row=i+1, column=j, padx=10, pady=5)
        
        # Adding operator buttons (+,-,*, /)
        operators = ['+', '-', '*', '/']
        row = 4
        for op in operators:
            if op == '/':
                command = lambda key='/': self.press(key)
            else:
                command = lambda key=op: self.press(key)
            
            Button(self, text=op, width=6, height=2,
                   command=command).grid(row=row, column=3, padx=5, pady=5)
            row += 1

    def press(self, key):
        current_expression = self.equation.get()
        try:
            result = eval(current_expression + key) if key.isnumeric() else key
        except Exception as e:
            messagebox.showerror('Error', str(e))
        else:
            self.current_expression += str(key)
            self.equation.set(self.current_expression)

def main():
    calc = Calculator()
    calc.create_ui()
    calc.mainloop()

if __name__ == "__main__":
    main()
