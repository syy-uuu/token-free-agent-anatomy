Result: __import__('tkinter')._setit
from tkinter import Tk, Label, Entry, Button, Frame
class CalculatorApp:
    def __init__(self):
        self.root = Tk()
        self.input_field = Entry(self.root)
        self.output_label = Label(self.root)
        self.create_digit_buttons()
        self.create_operator_buttons()
        self.create_clear_button()
        self.create_equals_button()

    # Additional methods to be defined later

    def create_digit_buttons(self):
        buttons = [
            ('7', 1, 0), ('8', 1, 1), ('9', 1, 2),
            ('4', 2, 0), ('5', 2, 1), ('6', 2, 2),
            ('1', 3, 0), ('2', 3, 1), ('3', 3, 2),
            ('0', 4, 1)
        ]

        for digit, row, col in buttons:
            Button(
                self.root,
                text=digit,
                command=lambda d=digit: self.on_button_click(d)
            ).grid(row=row, column=col, sticky='nsew')

    def create_operator_buttons(self):
        operators = ['+', '-', '*', '/']
        row = 1
        for operator in operators:
            Button(
                self.root,
                text=operator,
                command=lambda op=operator: self.on_button_click(op)
            ).grid(row=row, column=3, sticky='nsew')
            row += 1

    def create_clear_button(self):
        Button(
            self.root,
            text='C',
            command=self.clear_input_field
        ).grid(row=5, column=0, sticky='nsew')

    def create_equals_button(self):
        Button(
            self.root,
            text='=',
            command=self.calculate_result
        ).grid(row=5, column=2, columnspan=2, sticky='nsew')

    def on_button_click(self, value):
        if isinstance(value, str) and value == '=':
            self.calculate_result()
        else:
            self.input_field.insert('end', value)

    def clear_input_field(self):
        self.input_field.delete(0, 'end')

    def calculate_result(self):
        expression = self.input_field.get()
        try:
            result = eval(expression)
            self.output_label.config(text=result)
        except Exception as e:
            self.output_label.config(text='Error')

app = CalculatorApp()
root.mainloop()
------------------------------------------------------------

